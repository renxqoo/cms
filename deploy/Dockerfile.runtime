ARG NODE_IMAGE=node:24.22.1-bookworm-slim
FROM ${NODE_IMAGE}
WORKDIR /app
RUN test "$(node --version)" = "v24.22.1"
COPY --from=oven/bun:1.4.4 /usr/local/bin/bun /usr/local/bin/bun
ENV NODE_ENV=production
ENV API_HOST=127.0.0.1
ENV API_PORT=9091
ENV ADMIN_PORT=9092
COPY --chown=node:node runtime/ ./
USER node
EXPOSE 9091 9092
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD node -e "fetch('http://127.0.0.1:9091/livez').then(async r=>process.exit(r.status===200&&(await r.json()).status==='ok'?0:1)).catch(()=>process.exit(1))"
CMD ["node", "supervisor.mjs"]

NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=9091
ADMIN_PORT=9092
API_ALLOWED_HOSTS=cms.oneaster.example.com,127.0.0.1
API_ALLOWED_ORIGINS=https://www.oneaster.ai
CMS_API_ORIGIN=https://cms.oneaster.example.com
CMS_FRONTEND_URL=https://cms.oneaster.example.com
CMS_ADMIN_ORIGIN=https://cms.oneaster.example.com
CMS_API_BASE_URL=http://127.0.0.1:9091
CMS_MCP_RESOURCE=https://cms.oneaster.example.com/mcp
CMS_MCP_BRIDGE_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
CMS_RATE_LIMIT_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
DATABASE_URL=postgresql://user:password@db-host:5432/newcms?sslmode=verify-full
DATABASE_SCHEMA=public
CMS_MIGRATION_DATABASE_URL=postgresql://user:password@db-host:5432/newcms?sslmode=verify-full
CMS_STORAGE_DRIVER=local
CMS_STORAGE_ROOT=/var/lib/new-cms/assets
ONEASTER_CLIENT_ORIGIN=https://www.oneaster.ai
ONEASTER_PUBLIC_READ_IP_LIMIT=6000
CMS_MAINTENANCE_INTERVAL_MS=60000
CMS_ASSET_PROCESSING_INTERVAL_MS=1000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cms@example.com

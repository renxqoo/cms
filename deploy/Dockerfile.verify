FROM mcr.microsoft.com/playwright:v1.64.1-noble AS verification
WORKDIR /app
COPY --from=toolchain bun.zip /tmp/bun.zip
COPY --from=toolchain node.tar.xz /tmp/node.tar.xz
COPY --from=toolchain toolchain.sha256 /tmp/toolchain.sha256
RUN sha256sum --check /tmp/toolchain.sha256 && rm -f /etc/apt/sources.list.d/nodesource.list && sed -i -e 's/^Components:.*/Components: main/' -e 's|http://azure.archive.ubuntu.com/ubuntu/|https://archive.ubuntu.com/ubuntu/|' -e 's|http://security.ubuntu.com/ubuntu/|https://security.ubuntu.com/ubuntu/|' /etc/apt/sources.list.d/ubuntu.sources && apt-get -o Acquire::By-Hash=force -o Acquire::Retries=2 -o Acquire::http::Timeout=20 update && apt-get -o Acquire::By-Hash=force -o Acquire::Retries=2 -o Acquire::http::Timeout=20 install -y --no-install-recommends unzip ca-certificates nginx logrotate systemd openssl curl xz-utils && rm -rf /var/lib/apt/lists/* && unzip /tmp/bun.zip -d /tmp/bun && install -m 0755 /tmp/bun/bun-linux-x64/bun /usr/local/bin/bun && ln -sf /usr/local/bin/bun /usr/local/bin/bunx && tar -xJf /tmp/node.tar.xz -C /tmp && install -m 0755 /tmp/node-v24.22.1-linux-x64/bin/node /usr/local/bin/node && ln -sf /usr/local/bin/node /usr/bin/node && rm -rf /tmp/bun /tmp/bun.zip /tmp/node.tar.xz /tmp/node-v24.22.1-linux-x64 /tmp/toolchain.sha256 && chown pwuser:pwuser /app && test "$(node --version)" = "v24.22.1" && test "$(bun --version)" = "1.4.4"
COPY --chown=pwuser:pwuser package.json bun.lock ./
RUN --mount=type=cache,id=new-cms-bun-linux-x64,target=/bun-cache,uid=1001,gid=1001,sharing=locked chown -R pwuser:pwuser /bun-cache
USER pwuser
RUN --mount=type=cache,id=new-cms-bun-linux-x64,target=/home/pwuser/.bun/install/cache,uid=1001,gid=1001,sharing=locked bun install --frozen-lockfile
COPY --chown=pwuser:pwuser . .
ENV NEXT_TELEMETRY_DISABLED=1

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "trailingComma": "all",
  "ignorePatterns": [
    "docs/**",
    "**/dist/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/migrations/**",
    "**/generated/openapi.json",
    "packages/database/src/schema/generated/**",
    "apps/api/src/config/*.generated.json",
    "**/next-env.d.ts",
    "**/*.generated.ts"
  ]
}

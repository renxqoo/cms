  "faq": {
    "heading": {
      "eyebrow": "A few useful answers",
      "title": "Before you begin.",
      "description": "Model access, connection settings, and what this preview includes."
    },
    "documentationLink": {
      "kind": "internal",
      "label": "Read the documentation",
      "path": "/docs"
    },
    "items": [
      {
        "key": "prices",
        "question": "How do model prices work?",
        "answer": "The catalog lists separate input and output rates per million tokens, in USD. Each model’s detail view includes a token-cost calculator. The rates on this site are illustrative sample data, rather than live quotes. ",
        "link": {
          "kind": "internal",
          "label": "Explore the catalog",
          "path": "/models"
        },
        "afterLink": ".",
        "id": "cddbd962-06d8-4ca8-ac03-69e547ddb645"
      },
      {
        "key": "clients",
        "question": "Can I use an existing application or SDK?",
        "answer": "The examples use a chat-completions request with a base URL, Bearer API key, model ID, and messages. Check whether your client supports those settings and the request features you need. ",
        "link": {
          "kind": "internal",
          "label": "View the request format",
          "path": "/docs",
          "anchor": "request-format"
        },
        "afterLink": ".",
        "id": "70c85746-c0f5-4d51-9148-2fde65d30400"
      },
      {
        "key": "keys",
        "question": "How can I manage my API keys?",
        "answer": "The console lets you name and create sample keys for this browser session. The workspace walkthrough shows how project keys and usage fit together. Sample keys cannot authorize live requests.",
        "link": null,
        "afterLink": null,
        "id": "e261d085-59b0-49cd-a724-2633f1d06e7f"
      },
      {
        "key": "errors",
        "question": "What should I check when a request fails?",
        "answer": "Start with the endpoint, environment variable, model ID, and request body. The documentation includes a configuration checklist and shows how to inspect an HTTP response. ",
        "link": {
          "kind": "internal",
          "label": "Read the troubleshooting guide",
          "path": "/docs",
          "anchor": "troubleshooting"
        },
        "afterLink": ".",
        "id": "b269bde9-607e-4563-9ca3-7e2b733abb08"
      },
      {
        "key": "privacy",
        "question": "Does this preview send prompts to a provider?",
        "answer": "No. The interactive examples run locally in your browser. No live model API, sign-in, or payment service is connected. Production data handling and billing depend on the deployed service and provider policies.",
        "link": null,
        "afterLink": null,
        "id": "52e12717-6a67-48fd-bd9a-39c11c036ac2"
      }
    ]
  },
